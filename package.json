{
  "name": "project-mixer",
  "version": "0.1.0",
  "description": "VSCode を 5〜8 枚開かなくて済むようにするデスクトップアプリ",
  "main": "main.js",
  "author": "Project Mixer",
  "scripts": {
    "start": "electron .",
    "start:dev": "electron . --dev",
    "rebuild": "electron-rebuild -f -w node-pty",
    "build:renderer": "node build.cjs",
    "build:renderer:watch": "node build.cjs --watch",
    "test": "npm run test:phase0 && npm run test:phase1 && npm run test:phase2 && npm run test:phase2.5",
    "test:phase0": "node --test test/hook-settings.test.cjs",
    "test:phase1": "node --test test/phase1.test.cjs",
    "test:phase2": "node --test test/phase2.test.cjs",
    "test:phase2.5": "node --test test/phase2.5.test.cjs",
    "dev:v2": "node scripts/dev.cjs",
    "prestart": "node build.cjs",
    "prestart:dev": "node build.cjs",
    "predist": "node build.cjs",
    "predist:win": "node build.cjs",
    "predist:win:portable": "node build.cjs",
    "predist:mac": "node build.cjs",
    "predist:linux": "node build.cjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:win:portable": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.4.12",
    "marked": "^18.0.7",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.projectmixer.app",
    "productName": "Project Mixer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "hook-settings.cjs",
      "preload.js",
      "src/mcp/**/*",
      "src/ports/**/*",
      "src/files/**/*",
      "index.html",
      "styles.css",
      "dist/renderer.bundle.js",
      "dist/renderer.bundle.js.map",
      "dist/xterm.css",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "node-pty@1.1.0": true
  }
}
